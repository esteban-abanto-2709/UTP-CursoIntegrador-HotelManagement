generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

model Employee {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  password       String
  role           Role      @default(EMPLOYEE)
  dni            String?   @unique
  firstName      String?
  lastName       String?
  secondLastName String?
  birthDate      DateTime?
  position       String?
  shift          Shift?
  hireDate       DateTime?
  phone          String?
  email          String?   @unique
  address        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  roomCharges    RoomCharge[]
  payments       Payment[]
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

model Room {
  id           Int           @id @default(autoincrement())
  number       String        @unique
  type         RoomType
  status       RoomStatus    @default(AVAILABLE)
  price        Decimal       @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

model Guest {
  id           Int           @id @default(autoincrement())
  nationalId   String        @unique
  fullName     String
  email        String?
  phone        String?
  registeredAt DateTime      @default(now())
  reservations Reservation[]
}

enum ReservationStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model Reservation {
  id             Int               @id @default(autoincrement())
  checkIn        DateTime
  checkOut       DateTime
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  status         ReservationStatus @default(PENDING)
  pricePerNight  Decimal?          @db.Decimal(10, 2)
  room           Room              @relation(fields: [roomId], references: [id])
  roomId         Int
  guest          Guest             @relation(fields: [guestId], references: [id])
  guestId        Int
  charges        RoomCharge[]
  payment        Payment?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([roomId])
  @@index([guestId])
}

model ExpenseCategory {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  charges RoomCharge[]
}

model RoomCharge {
  id            Int             @id @default(autoincrement())
  reservation   Reservation     @relation(fields: [reservationId], references: [id])
  reservationId Int
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId    Int
  employee      Employee        @relation(fields: [registeredBy], references: [id])
  registeredBy  Int
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  chargedAt     DateTime        @default(now())

  @@index([reservationId])
  @@index([categoryId])
  @@index([registeredBy])
}

model Discount {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  percentage  Decimal   @db.Decimal(5, 2)
  isActive    Boolean   @default(true)
  payments    Payment[]
}

model Payment {
  id             Int           @id @default(autoincrement())
  reservation    Reservation   @relation(fields: [reservationId], references: [id])
  reservationId  Int           @unique
  employee       Employee      @relation(fields: [processedBy], references: [id])
  processedBy    Int
  paymentMethod  PaymentMethod
  discount       Discount?     @relation(fields: [discountId], references: [id])
  discountId     Int?
  roomTotal      Decimal       @db.Decimal(10, 2)
  chargesTotal   Decimal       @db.Decimal(10, 2)
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @db.Decimal(10, 2)
  grandTotal     Decimal       @db.Decimal(10, 2)
  processedAt    DateTime      @default(now())

  @@index([processedBy])
  @@index([discountId])
}
