generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

model Employee {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  password       String
  role           Role      @default(EMPLOYEE)
  dni            String?   @unique
  firstName      String?
  lastName       String?
  secondLastName String?
  birthDate      DateTime?
  positionId     Int?
  jobPosition    JobPosition? @relation(fields: [positionId], references: [id])
  shiftId        Int?
  shift          Shift?    @relation(fields: [shiftId], references: [id])
  hireDate       DateTime?
  phone          String?
  email          String?   @unique
  address        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  roomCharges    RoomCharge[]
  payments       Payment[]
  auditLogs      AuditLog[]
  createdReservations Reservation[]

  @@index([positionId])
  @@index([shiftId])
}

model JobPosition {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]
}

model Shift {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]
}

model Room {
  id           Int           @id @default(autoincrement())
  number       String        @unique
  typeId       Int?
  type         RoomType?     @relation(fields: [typeId], references: [id])
  statusId     Int?
  status       RoomStatus?   @relation(fields: [statusId], references: [id])
  price        Decimal       @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]

  @@index([typeId])
  @@index([statusId])
}

model RoomType {
  id    Int    @id @default(autoincrement())
  name  String @unique
  rooms Room[]
}

model RoomStatus {
  id    Int    @id @default(autoincrement())
  name  String @unique
  rooms Room[]
}

model Guest {
  id           Int           @id @default(autoincrement())
  nationalId   String        @unique
  fullName     String
  email        String?
  phone        String?
  registeredAt DateTime      @default(now())
  reservations Reservation[]
}

model Reservation {
  id             Int                @id @default(autoincrement())
  checkIn        DateTime
  checkOut       DateTime
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  statusId       Int?
  status         ReservationStatus? @relation(fields: [statusId], references: [id])
  rateSnapshot   Decimal?           @db.Decimal(10, 2)
  totalNights    Int?
  roomTotal      Decimal?           @db.Decimal(10, 2)
  room           Room               @relation(fields: [roomId], references: [id])
  roomId         Int
  guest          Guest              @relation(fields: [guestId], references: [id])
  guestId        Int
  charges        RoomCharge[]
  payment        Payment?
  createdBy      Int?
  creator        Employee?          @relation(fields: [createdBy], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([roomId])
  @@index([guestId])
  @@index([createdBy])
  @@index([statusId])
}

model ReservationStatus {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  reservations Reservation[]
}

model ExpenseCategory {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  charges RoomCharge[]
}

model RoomCharge {
  id            Int             @id @default(autoincrement())
  reservation   Reservation     @relation(fields: [reservationId], references: [id])
  reservationId Int
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId    Int
  employee      Employee        @relation(fields: [registeredBy], references: [id])
  registeredBy  Int
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  chargedAt     DateTime        @default(now())

  @@index([reservationId])
  @@index([categoryId])
  @@index([registeredBy])
}

model Discount {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  percentage  Decimal   @db.Decimal(5, 2)
  isActive    Boolean   @default(true)
  payments    Payment[]
}

model Payment {
  id             Int           @id @default(autoincrement())
  reservation    Reservation   @relation(fields: [reservationId], references: [id])
  reservationId  Int           @unique
  employee       Employee      @relation(fields: [processedBy], references: [id])
  processedBy    Int
  paymentMethodId Int?
  paymentMethod  PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  discount       Discount?     @relation(fields: [discountId], references: [id])
  discountId     Int?
  roomTotal      Decimal       @db.Decimal(10, 2)
  chargesTotal   Decimal       @db.Decimal(10, 2)
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @db.Decimal(10, 2)
  grandTotal     Decimal       @db.Decimal(10, 2)
  processedAt    DateTime      @default(now())

  @@index([processedBy])
  @@index([discountId])
  @@index([paymentMethodId])
}

model PaymentMethod {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  payments Payment[]
}

model AuditAction {
  id   Int        @id @default(autoincrement())
  name String     @unique
  logs AuditLog[]
}

model AuditLog {
  id            Int         @id @default(autoincrement())
  employee      Employee    @relation(fields: [employeeId], references: [id])
  employeeId    Int
  action        AuditAction @relation(fields: [actionId], references: [id])
  actionId      Int
  tableName     String
  recordId      Int
  previousValue String?
  newValue      String?
  performedAt   DateTime    @default(now())

  @@index([employeeId])
  @@index([actionId])
  @@index([tableName])
}
