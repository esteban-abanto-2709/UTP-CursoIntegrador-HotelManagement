generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum Turno {
  MAÑANA
  TARDE
  NOCHE
}

model Employee {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  password        String
  role            Role      @default(EMPLOYEE)
  // HR profile — nullable so the OWNER seed account doesn't need them
  dni             String?   @unique
  nombres         String?
  apellidoPaterno String?
  apellidoMaterno String?
  fechaNacimiento DateTime?
  cargo           String?
  turno           Turno?
  fechaInicio     DateTime?
  telefono        String?
  email           String?   @unique
  direccion       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

model Room {
  id           Int           @id @default(autoincrement())
  number       String        @unique
  type         RoomType
  status       RoomStatus    @default(AVAILABLE)
  price        Decimal       @db.Decimal(10, 2) // Tarifa por noche (S/.)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
}

enum ReservationStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model Reservation {
  id             Int               @id @default(autoincrement())
  guestName      String
  dni            String
  // Fechas planificadas de la reserva
  checkIn        DateTime
  checkOut       DateTime
  // Timestamps reales: se llenan al ejecutar el check-in/check-out
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  status         ReservationStatus @default(PENDING)
  // Facturación
  pricePerNight  Decimal?          @db.Decimal(10, 2) // Snapshot del precio al crear la reserva
  totalAmount    Decimal?          @db.Decimal(10, 2) // Calculado al check-out
  paymentMethod  PaymentMethod? // Elegido al check-out
  paidAt         DateTime? // Timestamp del cobro
  room           Room              @relation(fields: [roomId], references: [id])
  roomId         Int
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([roomId])
}
