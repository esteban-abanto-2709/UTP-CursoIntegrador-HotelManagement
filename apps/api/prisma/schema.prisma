generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum Turno {
  MAÑANA
  TARDE
  NOCHE
}

model Employee {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  password        String
  role            Role      @default(EMPLOYEE)
  // HR profile — nullable so the OWNER seed account doesn't need them
  dni             String?   @unique
  nombres         String?
  apellidoPaterno String?
  apellidoMaterno String?
  fechaNacimiento DateTime?
  cargo           String?
  turno           Turno?
  fechaInicio     DateTime?
  telefono        String?
  email           String?   @unique
  direccion       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
}

model Room {
  id        Int        @id @default(autoincrement())
  number    String     @unique
  type      RoomType
  status    RoomStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
