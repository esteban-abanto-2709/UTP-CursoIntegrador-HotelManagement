PORT=4000

# PostgreSQL Connection
DATABASE_URL=postgresql://user:password@localhost:5432/db_name     # connection pooling
DIRECT_URL=postgresql://user:password@localhost:5432/db_name       # migration

# Authentication — obligatorio
# la API no arranca sin esto.
# Genera uno propio, p. ej.: openssl rand -hex 32
JWT_SECRET=

# ─── Correo (Mailtrap Email Testing / Sandbox) ───────────────────
# Credenciales del sandbox: Mailtrap → Email Testing → tu inbox →
# Integration → SMTP. En sandbox el correo NO llega a nadie real
# y no requiere verificar dominio.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=