PORT=4000

# PostgreSQL Connection
DATABASE_URL=postgresql://user:password@localhost:5432/db_name     # connection pooling
DIRECT_URL=postgresql://user:password@localhost:5432/db_name       # migration

# Authentication — obligatorio
# la API no arranca sin esto.
# Genera uno propio, p. ej.: openssl rand -hex 32
JWT_SECRET=

# ─── Correo (Gmail SMTP) ─────────────────────────────────────────
# Envío real a cualquier bandeja. Usa una cuenta Gmail con
# verificación en 2 pasos activada y un App Password (16 chars,
# sin espacios) generado en https://myaccount.google.com/apppasswords
# MAIL_PASS es ese App Password, NO la contraseña de la cuenta.
# Puerto 587 (STARTTLS) funciona sin tocar código.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tucorreo@gmail.com
MAIL_PASS=
MAIL_FROM=Mirador Hotel Suite <tucorreo@gmail.com>