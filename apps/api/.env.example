PORT=4000

# PostgreSQL Connection
DATABASE_URL=postgresql://user:password@localhost:5432/db_name     # connection pooling
DIRECT_URL=postgresql://user:password@localhost:5432/db_name       # migration

# Authentication — obligatorio 
# la API no arranca sin esto. 
# Genera uno propio, p. ej.: openssl rand -hex 32
JWT_SECRET=

# CORS
FRONTEND_URL=http://localhost:3000