# ─── Base de datos (Postgres en Docker) ──────────────────────────
# El docker-compose levanta un Postgres en el servicio `db` y arma
# DATABASE_URL / DIRECT_URL automáticamente apuntando a `db:5432`.
# Cambia credenciales/puerto aquí si lo necesitas.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
POSTGRES_DB=hotel_db
POSTGRES_PORT=5432

# ─── Producción vs. desarrollo ───────────────────────────────────
# Por defecto (esta línea comentada) NO se publica el puerto de la BD:
# modo producción, todo cerrado.
# Para desarrollo, descomenta la línea para publicar el puerto de
# Postgres al host y poder usar Prisma Studio:
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Authentication
JWT_SECRET=super-secret-key-123

# ─── Seeds al arrancar el contenedor api ─────────────────────────
# Controla qué siembra el entrypoint tras aplicar migraciones.
#   none → no siembra nada (default seguro para producción establecida)
#   base → solo datos base (owner + catálogos)
#   demo → base + datos de prueba (rooms, huéspedes, reservas, pagos…)
# Es idempotente: dejarlo en demo no duplica al reiniciar.
SEED_MODE=none

# ─── Correo (Gmail SMTP) ─────────────────────────────────────────
# Se inyectan al contenedor `api` vía env_file. Envío real a
# cualquier bandeja. Cuenta Gmail con verificación en 2 pasos y un
# App Password (16 chars, sin espacios) generado en
# https://myaccount.google.com/apppasswords — MAIL_PASS es ese App
# Password, NO la contraseña de la cuenta. Puerto 587 (STARTTLS).
# OJO: sin comillas — env_file de docker las trata como literales.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tucorreo@gmail.com
MAIL_PASS=
MAIL_FROM=Mirador Hotel Suite <tucorreo@gmail.com>

# ─── Cloudflare Tunnel ───────────────────────────────────────────
# Token del túnel con dominio en Cloudflare Zero Trust. Expone la web
# (servicio `web`) al exterior sin abrir puertos en el servidor.
TUNNEL_TOKEN=
