PORT=4000

# ─── Base de datos LOCAL (Docker) ────────────────────────────────
# El docker-compose levanta un Postgres en el servicio `db` y arma
# DATABASE_URL / DIRECT_URL automáticamente apuntando a `db:5432`.
# Estas variables solo cambian credenciales/puerto si lo necesitas.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
POSTGRES_DB=hotel_db
POSTGRES_PORT=5432

# ─── Base de datos REMOTA (Supabase) ─────────────────────────────
# Solo se usan fuera de Docker (dev local apuntando a la nube).
# Dentro de Docker, el compose las sobrescribe con la BD local.
DATABASE_URL=postgresql://user:password@localhost:5432/db_name     # connection pooling
DIRECT_URL=postgresql://user:password@localhost:5432/db_name       # migration

# Authentication
JWT_SECRET=super-secret-key-123

# CORS
FRONTEND_URL=http://localhost:3000

# ─── Frontend (apps/web) ─────────────────────────────────────────
# Se HORNEA en build time (lo lee el cliente). En local el navegador
# corre en el host, así que apunta a localhost:4000 (NO a `api:4000`,
# que solo resuelve dentro de la red Docker). En el deploy de Digital
# Ocean, ponlo en la URL pública del API antes de rebuildear.
NEXT_PUBLIC_API_URL=http://localhost:4000
