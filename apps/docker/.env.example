# ─── Base de datos (Postgres en Docker) ──────────────────────────
# El docker-compose levanta un Postgres en el servicio `db` y arma
# DATABASE_URL / DIRECT_URL automáticamente apuntando a `db:5432`.
# Cambia credenciales/puerto aquí si lo necesitas.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
POSTGRES_DB=hotel_db
POSTGRES_PORT=5432

# Authentication
JWT_SECRET=super-secret-key-123

# ─── Cloudflare Tunnel ───────────────────────────────────────────
# Token del túnel con dominio en Cloudflare Zero Trust. Expone la web
# (servicio `web`) al exterior sin abrir puertos en el servidor.
TUNNEL_TOKEN=
